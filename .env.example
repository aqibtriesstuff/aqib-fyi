# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Supabase — get these from your project's Settings > API page
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — only used in the admin panel (client-side, protected by password)
# Get this from Settings > API > service_role key
# This key bypasses Row Level Security, so keep it private
PUBLIC_SUPABASE_SERVICE_KEY=your-service-role-key-here

# Admin password for /library/admin
# Choose anything you'll remember — this is client-side only for now
PUBLIC_ADMIN_PASSWORD=your-admin-password-here
