---
import Layout from '../layouts/Layout.astro';
import DialogueNav from '../components/DialogueNav.astro';
import TalkButton from '../components/TalkButton.astro';
---

<style>
  html, body { overflow: hidden; height: 100%; }
</style>

<Layout
  title="aqib raza"
  description="aqib.fyi — a quiet corner of the internet."
  showTalkButton={false}
>
  <!-- TalkButton hidden on homepage until "just looking" is chosen -->
  <div id="homepage-talk" style="display: none;">
    <TalkButton />
  </div>

  <div class="h-screen flex items-center justify-center px-6 overflow-hidden">
    <DialogueNav />
  </div>
</Layout>

<script>
  document.addEventListener('show-talk-button', () => {
    const wrap = document.getElementById('homepage-talk');
    if (wrap) wrap.style.display = 'block';
  });
</script>